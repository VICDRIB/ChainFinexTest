PORT=3000
SESSION_SECRET=change-this-to-a-random-secret-in-production
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (SMTP) — for email notifications
# Use Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Use an App Password for Gmail (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=ChainFinex <noreply@ChainFinex.io>
ADMIN_EMAIL=admin@example.com

# App base URL (used in email links)
APP_URL=http://localhost:3000
